# AI Provider Configuration
# "workers-ai" is the MVP default: it uses the `[ai]` binding configured in
# wrangler.toml (Cloudflare Workers AI, model @cf/zai-org/glm-5.3-flash) and
# needs no API key. It's a real Cloudflare binding, not a local .env var —
# nothing to set here for local `wrangler dev` to pick it up.
AI_PROVIDER=workers-ai
VOICE_PROVIDER=null

# Optional: OpenAI API Key (only needed if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Optional: Z.ai API Key (for future implementation)
# ZAI_API_KEY=...

# Optional: Gemini API Key (for future implementation)
# GEMINI_API_KEY=...

# Safety Configuration
SAFETY_RULESET_VERSION=1.0.0
LOG_SAFETY_METADATA=true

# Supabase Configuration
# REQUIRED. The Supabase project's JWT secret (Dashboard -> Project Settings
# -> API -> JWT Secret). Used to cryptographically verify the Authorization:
# Bearer token on every request — without it every request is rejected as
# "Server misconfigured". Set with `wrangler secret put SUPABASE_JWT_SECRET`;
# never commit the real value.
SUPABASE_JWT_SECRET=...
