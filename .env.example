# AI Provider Configuration
AI_PROVIDER=openai
VOICE_PROVIDER=null

# OpenAI API Key (required for AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Optional: Z.ai API Key (for future implementation)
# ZAI_API_KEY=...

# Optional: Gemini API Key (for future implementation)
# GEMINI_API_KEY=...

# Safety Configuration
SAFETY_RULESET_VERSION=1.0.0
LOG_SAFETY_METADATA=true

# Supabase Configuration
# REQUIRED. The Supabase project's JWT secret (Dashboard -> Project Settings
# -> API -> JWT Secret). Used to cryptographically verify the Authorization:
# Bearer token on every request — without it every request is rejected as
# "Server misconfigured". Set with `wrangler secret put SUPABASE_JWT_SECRET`;
# never commit the real value.
SUPABASE_JWT_SECRET=...
